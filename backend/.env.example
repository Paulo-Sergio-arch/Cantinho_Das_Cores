# Ambiente da aplicação: development | production
APP_ENV=development

# Segredo JWT (em produção: obrigatório >= 32 caracteres aleatórios)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-secret-before-deploying
JWT_EXPIRE_MINUTES=60

# Origens permitidas no CORS (separadas por vírgula, sem '*' em produção)
CORS_ORIGINS=http://localhost:5185,http://localhost:5173,https://cantinho-das-cores.vercel.app

# Banco de dados:
# - Em desenvolvimento/testes locais, deixe DATABASE_URL vazio para usar SQLite (DATABASE_PATH).
# - Em produção (Render), preencha DATABASE_URL com a Connection String (URI) do Supabase PostgreSQL.
DATABASE_URL=
DATABASE_PATH=data/cantinho_das_cores.sqlite3
BACKUP_DIR=data/backups
BACKUP_KEEP_COUNT=10

# Rate limits e chave administrativa para backups (/api/system/backup)
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=300
GUEST_RATE_LIMIT_MAX_ATTEMPTS=30
GUEST_RATE_LIMIT_WINDOW_SECONDS=60
REPORT_SEND_RATE_LIMIT_MAX_ATTEMPTS=10
REPORT_SEND_RATE_LIMIT_WINDOW_SECONDS=3600
ENABLE_DOCS_IN_PRODUCTION=false
ADMIN_API_KEY=change-this-admin-key-before-deploying

# Canal de envio de relatórios: console | email | smtp | resend | brevo | webhook
REPORT_DELIVERY_MODE=console
RESEND_API_KEY=
RESEND_FROM=
BREVO_API_KEY=
BREVO_FROM_NAME=Cantinho das Cores
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@cantinhodascores.com.br
SMTP_USE_TLS=true
REPORT_WEBHOOK_URL=
